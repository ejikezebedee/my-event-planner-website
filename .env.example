# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
# Public origin of the web app (CORS + cookie scope). Comma-separated list allowed.
WEB_ORIGIN=http://localhost:3000
# Public base URL of the web app — used to build links in emails.
APP_BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://mep:mep@localhost:5432/my_event_planner

# Redis (BullMQ email queue). The API starts without Redis and sends mail
# inline; with Redis, run the dedicated worker process (`pnpm --filter @mep/api
# start:worker`) which delivers queued mail with retries.
REDIS_URL=redis://localhost:6379
# Express trust proxy setting, e.g. loopback, linklocal, uniquelocal
TRUST_PROXY=loopback

# Sessions (database-backed tokens — no JWT anywhere in this stack)
SESSION_TTL_DAYS=30
# Set the Secure flag on the session cookie (requires HTTPS — mandatory in production)
SESSION_COOKIE_SECURE=false
# Block app usage until the account's email address is verified.
# Defaults: on in production (cannot be disabled there), off in dev/test.
REQUIRE_EMAIL_VERIFICATION=false
# Swagger UI at /docs — off in production unless explicitly enabled
SWAGGER_ENABLED=false
# Background schedulers (notifications, retention cleanup) — set false to disable
SCHEDULER_ENABLED=true
# Auth endpoint rate limits (per minute per client) — keep low in production
AUTH_REGISTER_RATE_LIMIT=5
AUTH_LOGIN_RATE_LIMIT=10

# Email: provider = resend | smtp | console (console logs links; default in dev,
# rejected in production)
EMAIL_PROVIDER=console
CONTACT_EMAIL=contact@your-domain.example
CONTACT_RATE_LIMIT=5
EMAIL_FROM="My Event Planner <no-reply@example.com>"
RESEND_API_KEY=
# Full SMTP connection URL, e.g. smtp://user:pass@smtp.example.com:587
SMTP_URL=

# Uploads: optional malware-scan HTTP bridge (e.g. ClamAV REST wrapper).
# Empty is allowed only in development/test; production requires a real scanner.
MALWARE_SCAN_URL=

# Storage: driver = local | s3 (S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_DRIVER=local
STORAGE_DIR=./data/uploads
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_BUCKET=my-event-planner
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Seconds a signed download URL stays valid
SIGNED_URL_TTL=300

# Uploads
MAX_UPLOAD_MB=10

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
# Server-side API origin for the same-origin proxy (Docker all-in-one image)
API_INTERNAL_URL=
